# ── LLM Provider（OpenAI 兼容）────────────────────────────
# 推荐国内：stepfun_plan | deepseek | dashscope | zhipu | moonshot | siliconflow
# 可选：stepfun | volcengine | minimax | yi | baichuan | xai | openai | custom
LLM_PROVIDER=stepfun_plan

# 通用 Key（优先使用）；也可填对应厂商专用变量
LLM_API_KEY=
# 留空则使用该 Provider 默认 Base URL / 模型
LLM_BASE_URL=
LLM_MODEL=

# ── 阶跃星辰 StepFun ──────────────────────────────────────
# Coding Plan / Step Plan 订阅额度：LLM_PROVIDER=stepfun_plan
# Base: https://api.stepfun.com/step_plan/v1
# 模型示例: step-3.7-flash | step-3.5-flash
# 标准按量 API：LLM_PROVIDER=stepfun  Base: https://api.stepfun.com/v1
STEPFUN_API_KEY=

# ── 其他国内常见厂商（按需填写）────────────────────────────
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
SILICONFLOW_API_KEY=
ARK_API_KEY=
MINIMAX_API_KEY=
YI_API_KEY=
BAICHUAN_API_KEY=
OPENAI_API_KEY=

# ── xAI / Grok（海外，兼容旧配置）─────────────────────────
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5

# ── BP Meta ───────────────────────────────────────────────
# auto = 有 STRATZ_API_TOKEN 用 STRATZ，否则 OpenDota
META_SOURCE=auto

# OpenDota（免费公开 API，可选 key 提高限额）
OPENDOTA_API_KEY=
# 0=全部段位合计；1-8=单一括号
OPENDOTA_BRACKET=0

# STRATZ（免费 API，需用户自己注册 Token）
# 获取: https://stratz.com/api  （请求需 User-Agent: STRATZ_API）
# 人多用时请各自填写自己的 Token，不要共享同一个
STRATZ_API_TOKEN=
# all | low | mid | high | divine_immortal | legend_ancient | crusader_archon | herald_guardian
STRATZ_BRACKET=high

# ── GSI ───────────────────────────────────────────────────
GSI_HOST=127.0.0.1
GSI_PORT=3000
GSI_AUTH_TOKEN=dodoclaw_secret
# 1 = 把原始 GSI 数据按局写到 logs/gsi/*.jsonl（不含 token），用于排查和采样
GSI_RECORD=0

# ── Voice / ASR / TTS ─────────────────────────────────────
# ASR: mock | whisper | stepfun_plan | stepfun
STT_BACKEND=mock
STT_MODEL=
# TTS: mock | edge | stepfun_plan | stepfun
TTS_BACKEND=mock
TTS_MODEL=
# Step TTS 音色示例: cixingnansheng | linjiajiejie | yuanqishaonv
TTS_VOICE=
# Step Plan 语音与 LLM 共用 STEPFUN_API_KEY / LLM_API_KEY
# ASR 模型: stepaudio-2.5-asr   TTS 模型: stepaudio-2.5-tts
# 文档: https://platform.stepfun.com/docs/zh/step-plan/integrations/audio-api
WAKE_WORD_ENABLED=false
COACH_LANGUAGE=zh-CN
