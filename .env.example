# ── 教练 Key ─────────────────────────────────────────────
# 这里只放 Key。服务商和模型在 config\settings.yaml 的 coach.provider / coach.model 里选，
# 默认 DeepSeek（deepseek-flash，关闭思考模式）。
# 在下面填你所选服务商对应的那一行即可；也可以填通用的 LLM_API_KEY。
LLM_API_KEY=

# ── 阶跃星辰 StepFun ──────────────────────────────────────
# Step Plan 订阅（coach.provider: stepfun_plan）和按量计费（coach.provider: stepfun）都用这个 Key
# Step Plan 的语音识别 / 播报也共用这个 Key
STEPFUN_API_KEY=

# ── 其他国内常见厂商（按需填写）────────────────────────────
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
SILICONFLOW_API_KEY=
ARK_API_KEY=
MINIMAX_API_KEY=
YI_API_KEY=
BAICHUAN_API_KEY=
OPENAI_API_KEY=

# ── xAI / Grok（海外，兼容旧配置）─────────────────────────
XAI_API_KEY=

# ── BP Meta ───────────────────────────────────────────────
# auto = 有 STRATZ_API_TOKEN 用 STRATZ，否则 OpenDota
META_SOURCE=auto

# OpenDota（免费公开 API，可选 key 提高限额）
OPENDOTA_API_KEY=
# 0=全部段位合计；1-8=单一括号
OPENDOTA_BRACKET=0

# STRATZ（免费 API，需用户自己注册 Token）
# 获取: https://stratz.com/api  （请求需 User-Agent: STRATZ_API）
# 人多用时请各自填写自己的 Token，不要共享同一个
STRATZ_API_TOKEN=
# all | low | mid | high | divine_immortal | legend_ancient | crusader_archon | herald_guardian
STRATZ_BRACKET=high

# ── GSI ───────────────────────────────────────────────────
GSI_HOST=127.0.0.1
GSI_PORT=3000
GSI_AUTH_TOKEN=dodoclaw_secret
# 1 = 把原始 GSI 数据按局写到 logs/gsi/*.jsonl（不含 token），用于排查和采样
GSI_RECORD=0

# ── Voice / ASR / TTS ─────────────────────────────────────
# ASR: mock | whisper | stepfun_plan | stepfun
STT_BACKEND=mock
STT_MODEL=
# TTS: mock | edge | stepfun_plan | stepfun
TTS_BACKEND=mock
TTS_MODEL=
# Step TTS 音色示例: cixingnansheng | linjiajiejie | yuanqishaonv
TTS_VOICE=
# Step Plan 语音与 LLM 共用 STEPFUN_API_KEY / LLM_API_KEY
# ASR 模型: stepaudio-2.5-asr   TTS 模型: stepaudio-2.5-tts
# 文档: https://platform.stepfun.com/docs/zh/step-plan/integrations/audio-api
WAKE_WORD_ENABLED=false
COACH_LANGUAGE=zh-CN
